# Copy to .env.local and fill in. Never commit .env.local.

FLIGHT_PROVIDER=duffel
DUFFEL_MODE=test

# Free sandbox key: duffel.com → dashboard → Test Mode → create token.
DUFFEL_TEST_KEY=

# Production key (needs KYC + card on file at Duffel). Leave empty until then.
DUFFEL_LIVE_KEY=

# Keep false. Booking needs live mode + live key + true, all at once.
BOOKING_ENABLED=false

# Supabase (free tier) — for bookings history + real login, after exams.
# Get from Supabase dashboard → project → Settings → API Keys.
# The sbp_... key the user shared goes here, NEVER committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Flight status (Aviationstack free tier, display only). Get at aviationstack.com.
AVIATIONSTACK_KEY=

# Schedules (AeroDataBox via RapidAPI, Basic free). Subscribe on RapidAPI, paste app key.
RAPIDAPI_KEY=

# Server-only (never NEXT_PUBLIC): Supabase service_role JWT + personal token.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PERSONAL_TOKEN=
